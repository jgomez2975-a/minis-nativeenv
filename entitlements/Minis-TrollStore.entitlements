<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
	  Minis-TrollStore.entitlements

	  The minimum that makes a real arm64 process executable, and nothing more.

	  An earlier revision added the full TrollStore set — no-container,
	  no-sandbox, AppDataContainers, AppBundles, background-task, extended
	  virtual addressing, persona-mgmt — to let the runtime root live at
	  /var/mobile/Library. Minis is an App Store app: its startup path creates
	  files under Library/Application Support and resolves an app-group
	  container within the first seconds. A container-less process makes those
	  paths unwritable, and the result is a launch that dies before anything
	  reports why.

	  So the runtime root now lives inside the app's own container
	  (RuntimePaths.containerRoot), which needs no entitlements at all, and the
	  only additions over stock Minis are the two keys that gate process
	  execution.

	  Stock entitlements are preserved verbatim below. Dropping any of them
	  silently disables a device tool rather than failing loudly.
	-->
	<key>platform-application</key>
	<true/>
	<key>get-task-allow</key>
	<true/>

	<!-- ===== stock Minis entitlements, preserved ===== -->
	<key>aps-environment</key>
	<string>development</string>
	<key>com.apple.developer.healthkit</key>
	<true/>
	<key>com.apple.developer.healthkit.access</key>
	<array>
		<string>health-records</string>
	</array>
	<key>com.apple.developer.homekit</key>
	<true/>
	<key>com.apple.developer.icloud-container-identifiers</key>
	<array>
		<string>iCloud.com.openminis.app</string>
	</array>
	<key>com.apple.developer.icloud-services</key>
	<array>
		<string>CloudKit</string>
	</array>
	<key>com.apple.developer.nfc.readersession.formats</key>
	<array>
		<string>TAG</string>
		<string>PACE</string>
	</array>
	<key>com.apple.developer.ubiquity-container-identifiers</key>
	<array>
		<string>iCloud.com.openminis.app</string>
	</array>
	<key>com.apple.developer.weatherkit</key>
	<true/>
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.com.openminis.app</string>
	</array>
</dict>
</plist>
